# Copia in .env e compila. Il file .env non va committato.

# ========== Endpoint HTTP di riferimento ==========
# Config da web ProgettoTesi (tipico localhost:8080):
#   GET REMOTE_CONFIG_URL → .../app/api/config/{ID_CONDOMINIO}
# JWT REMOTE_CONFIG_TOKEN = ADMIN web (POST /app/api/auth/login).
#
# Upload misure:
# A) Web telemetry (batch gateway legacy): DATA_UPLOAD_FORMAT=web (default)
#    POST DATA_UPLOAD_URL → es. http://localhost:8080/app/api/gateway/{ID_CONDOMINIO}/telemetry
# B) Middleware ingest consumi (array ConsumoIngestItem): DATA_UPLOAD_FORMAT=middleware
#    POST DATA_UPLOAD_URL → es. http://localhost:8081/api/consumi (server.port sul middleware)
#    Opzione consigliata in dev: GATEWAY_INGEST_SECRET = app.gateway-ingest.secret (header X-Gateway-Ingest-Token).
#    In alternativa: Bearer = JWT middleware (POST /auth/login con form username/password admin), DATA_UPLOAD_TOKEN=...

ID_CONDOMINIO=1

# JWT web ADMIN per scaricare la config
REMOTE_CONFIG_TOKEN=

REMOTE_CONFIG_URL=http://localhost:8080/app/api/config

# --- Upload (web telemetry oppure middleware consumi) ---
# Consigliato per test: middleware + GATEWAY_INGEST_SECRET (allineato al middleware application.properties).
DATA_UPLOAD_FORMAT=middleware
DATA_UPLOAD_URL=http://localhost:8081/api/consumi
GATEWAY_INGEST_SECRET=dev-gateway-ingest-secret
# DATA_UPLOAD_TOKEN=   # solo se usi Bearer JWT middleware al posto del secret

# Esempio solo-telemetry verso web:
# DATA_UPLOAD_FORMAT=web
# DATA_UPLOAD_URL=http://localhost:8080/app/api/gateway/1/telemetry

# Invio telemetria: batch a fine lettura di tutti i dispositivi (non più un timer periodico che inviava solo i primi record).
# DATA_UPLOAD_INTERVAL_SECONDS resta nel config locale ma non governa più l’upload; retry se buffer non vuoto a fine pausa ciclo.
DATA_UPLOAD_INTERVAL_SECONDS=30

# Ciclo lettura: durata totale = system_config.poll_interval (es. 60). Metà = finestra lettura minima, resto = pausa.
# GATEWAY_CYCLE_TOTAL_SECONDS=60
# GATEWAY_READ_PHASE_SECONDS=30

# KNX: xknx usa UDP (TUNNELING) di default. Molti gateway/simulatori richiedono TCP:
# KNX_TUNNEL_TCP=true
# Stesso effetto da config remota: system_config.knx.tunnel_tcp (o tunnelTcp), oppure
# system_config.knx.gateways[].tunnel_tcp per singolo gateway IP.
# Timeout ValueReader per ogni GA (secondi; prima era fisso a 2s in xknx):
# KNX_GROUP_READ_TIMEOUT_SECONDS=20
# Dopo un errore di tunnel, nuovo tentativo ogni N secondi (non più disabilitazione permanente):
# KNX_RECONNECT_INTERVAL_SECONDS=60

# M-Bus: timeout lettura pyserial (recv); tetto opzionale come Modbus RTU:
# MBUS_SERIAL_TIMEOUT_SECONDS=3
# MBUS_SERIAL_TIMEOUT_CAP_SECONDS=12
# Alcuni contatori non rispondono al ping: salta SND-NKE e usa solo richiesta dati
# MBUS_SKIP_PING=true

# Timeout massimo per lettura di un intero dispositivo (Modbus/M-Bus/KNX aggregato); evita stalli del loop:
# DEVICE_READ_TIMEOUT_SECONDS=60

# pymodbus: timeout socket per connect/read e retry interni (0 = un solo tentativo, meno attese):
# MODBUS_TIMEOUT_SECONDS=5
# MODBUS_RETRIES=0
# Modbus TCP: dopo ogni lettura si ricrea l’istanza pymodbus (close+nuovo client) e si rifà connect al ciclo dopo;
# così si evitano letture vuote al 2° giro su Windows/simulatori. Sessione persistente (solo close, stesso client):
# MODBUS_TCP_KEEP_SESSION_OPEN=true
# Tetto secondi per timeout lettura su Modbus RTU (la web app può inviare 60s; qui si riduce per non attendere minuti):
# MODBUS_SERIAL_TIMEOUT_CAP_SECONDS=12
# Metti 0 per disattivare il limite e usare solo il valore della config.
# Pausa tra una lettura registro e la successiva su RTU (adattatori USB/RS-485 lenti); 0 = disabilita:
# MODBUS_RTU_INTER_REGISTER_DELAY_SECONDS=0.02
