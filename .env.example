# Copia in .env e compila. Il file .env non va committato.

ID_CONDOMINIO=1

# JWT: POST http://localhost:8080/app/api/auth/login
# Body: {"username":"email_admin","password":"..."} → access_token
REMOTE_CONFIG_TOKEN=

# Base URL senza id finale (aggiunto /{ID_CONDOMINIO}), oppure con placeholder:
# REMOTE_CONFIG_URL=http://localhost:8080/app/api/config
# REMOTE_CONFIG_URL=http://localhost:8080/app/api/buildings/{id}/config
REMOTE_CONFIG_URL=http://localhost:8080/app/api/config

DATA_UPLOAD_URL=http://localhost:8080/app/api/gateway/1/telemetry
DATA_UPLOAD_INTERVAL_SECONDS=30
