# Copia in .env e compila. Il file .env non va committato.
#
# Rete lab (esempio): PC servizi 192.168.8.115 | Gateway Raspberry 192.168.8.154
# Web App: COM1/COM3, 127.0.0.1:502 — sulla Pi basta PC_IP (remap al mirror sul PC).
# PC lab: python lab_sim.py + Desktop\iot_lab_mirror\Avvia.bat

# ========== Identità edificio ==========
ID_CONDOMINIO=1

# ========== Rete lab (gateway sulla Pi, simulatori sul PC) ==========
# PC_IP: obbligatorio sulla Pi per M-Bus/Modbus simulati (remap COMx / 127.0.0.1).
PC_IP=192.168.8.115
# RASPBERRY_IP: solo documentazione (non letto dal runtime).
RASPBERRY_IP=192.168.8.154
# Porte mirror opzionali (default: M-Bus 9000, Modbus TCP 502, Modbus RTU 9010):
# MBUS_TCP_PORT=9000
# MODBUS_TCP_PORT=502
# MODBUS_RTU_TCP_PORT=9010

# ========== Autenticazione M2M (Web App) ==========
# POST WEB_AUTH_TOKEN_URL con GATEWAY_CLIENT_ID + GATEWAY_CLIENT_SECRET.
# Credenziali: POST /app/api/buildings/{ID}/gateway-credentials (JWT admin).
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
WEB_AUTH_TOKEN_URL=http://192.168.8.115:8080/app/api/auth/token

# ========== Config remota Web App ==========
# GET REMOTE_CONFIG_URL/{ID_CONDOMINIO}
REMOTE_CONFIG_URL=http://192.168.8.115:8080/app/api/config

# ========== Upload telemetria ==========
# middleware → middleware :8081 | web → web app telemetry API
DATA_UPLOAD_FORMAT=middleware
DATA_UPLOAD_URL=http://192.168.8.115:8081/api/consumi
# Esempio solo web telemetry:
# DATA_UPLOAD_FORMAT=web
# DATA_UPLOAD_URL=http://192.168.8.115:8080/app/api/gateway/1/telemetry
# Legacy: non governa il timer di upload; retry a fine ciclo se buffer non vuoto.
DATA_UPLOAD_INTERVAL_SECONDS=30

# ========== Ciclo gateway ==========
# poll_interval da JSON remoto (default ciclo 60s). Override opzionali:
# CONFIG_REFRESH_INTERVAL_SECONDS=300
# GATEWAY_CYCLE_TOTAL_SECONDS=60
# GATEWAY_READ_PHASE_SECONDS=30
# DEVICE_READ_TIMEOUT_SECONDS=60

# ========== KNX ==========
# KNX_TUNNEL_TCP=true
# KNX_GROUP_READ_TIMEOUT_SECONDS=20
# KNX_RECONNECT_INTERVAL_SECONDS=60
# Mirror lab :3672 → KNX Virtual :3671; non serve KNX_ROUTE_BACK=true.

# ========== M-Bus ==========
# MBUS_SKIP_PING=true
# MBUS_SERIAL_TIMEOUT_SECONDS=3
# MBUS_SERIAL_TIMEOUT_CAP_SECONDS=12

# ========== Modbus (pymodbus) ==========
# MODBUS_TIMEOUT_SECONDS=5
# MODBUS_RETRIES=0
# MODBUS_TCP_KEEP_SESSION_OPEN=true
# MODBUS_SERIAL_TIMEOUT_CAP_SECONDS=12
# MODBUS_RTU_INTER_REGISTER_DELAY_SECONDS=0.02
